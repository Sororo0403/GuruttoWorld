<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="References" />
    <Filter Include="References\ExternalGame" />
    <Filter Include="References\ExternalGame\Assets" />
    <Filter Include="References\ExternalGame\Assets\Scripts" />
    <Filter Include="src" />
    <Filter Include="src\Support" />
    <Filter Include="src\Gameplay" />
    <Filter Include="src\Rendering" />
    <Filter Include="src\Scene" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\Gameplay\SunriseStreetValidation.cpp">
      <Filter>src\Gameplay</Filter>
    </ClCompile>
    <ClCompile Include="src\Gameplay\SunriseSoundValidation.cpp">
      <Filter>src\Gameplay</Filter>
    </ClCompile>
    <ClCompile Include="$(TestGameRoot)\Assets\Scripts\StreetArrival.cpp">
      <Filter>References\ExternalGame\Assets\Scripts</Filter>
    </ClCompile>
    <ClCompile Include="$(TestGameRoot)\Assets\Scripts\StreetJourney.cpp">
      <Filter>References\ExternalGame\Assets\Scripts</Filter>
    </ClCompile>
    <ClInclude Include="src\Gameplay\ParkResourceValidation.h">
      <Filter>src\Gameplay</Filter>
    </ClInclude>
    <ClInclude Include="src\Scene\LayoutDeltaValidation.h">
      <Filter>src\Scene</Filter>
