    <ClInclude Include="src\Rendering\SpriteResourceValidation.h">
      <Filter>src\Rendering</Filter>
    </ClInclude>
    <ClInclude Include="src\Support\ModernScriptHarness.h">
      <Filter>src\Support</Filter>
