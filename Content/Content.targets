<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GameContentRoot Condition="'$(GameContentRoot)' == ''">$(MSBuildThisFileDirectory)</GameContentRoot>
    <GameWorkRoot Condition="'$(GameProjectRoot)' == ''">$(MSBuildThisFileDirectory)..\</GameWorkRoot>
    <GameWorkRoot Condition="'$(GameProjectRoot)' != ''">$(GameProjectRoot)</GameWorkRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)ScriptSchemas.targets" />
  <Import Project="$(MSBuildThisFileDirectory)ThirdPartyLicenses.targets" />
  <Target Name="CopySharedContent" AfterTargets="Build" DependsOnTargets="CopyThirdPartyLicenses">
    <PropertyGroup>
      <FallbackContentArgument Condition="'$(FallbackContentRoot)' != ''"> -FallbackContent &quot;$(FallbackContentRoot)\.&quot;</FallbackContentArgument>
    </PropertyGroup>
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\SyncBuildContent.ps1&quot; -Content &quot;$(GameContentRoot).&quot; -Destination &quot;$(OutDir).&quot;$(FallbackContentArgument)" />
  </Target>
  <!-- 本体と同じヘッダー・ライブラリでDLLを作り、古いContentのDLLを最後に置き換える。 -->
  <Target Name="BuildSharedScripts" AfterTargets="CopySharedContent" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipGameScripts)' != 'true'">
    <PropertyGroup>
      <ScriptOutputContent>$([System.IO.Path]::GetFullPath('$(OutDir).'))</ScriptOutputContent>
    </PropertyGroup>
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\BuildScripts.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Content &quot;$(GameContentRoot).&quot; -OutputContent &quot;$(ScriptOutputContent)&quot; -WorkRoot &quot;$(GameWorkRoot).&quot;" />
  </Target>
</Project>
