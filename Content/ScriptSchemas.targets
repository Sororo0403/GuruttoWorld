<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GameContentRoot Condition="'$(GameContentRoot)' == ''">$(MSBuildThisFileDirectory)</GameContentRoot>
  </PropertyGroup>
  <Target Name="GenerateSharedScriptSchemas" BeforeTargets="ClCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipGameScripts)' != 'true'">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\GenerateScriptSchemas.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Content &quot;$(GameContentRoot).&quot;" />
  </Target>
</Project>
